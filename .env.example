# URL pública OFICIAL do LG Agenda
NEXT_PUBLIC_SITE_URL=https://lg-agenda.vercel.app

# Supabase
# Project URL. Use exatamente o valor copiado do painel do Supabase.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Publishable Key (sb_publishable_...). É pública por definição.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret Key (sb_secret_...). NUNCA exponha no navegador/GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago - ACCESS TOKEN DE PRODUÇÃO para receber pagamentos reais
MERCADO_PAGO_ACCESS_TOKEN=


# Endpoint /api/reminders/run
CRON_SECRET=troque-por-uma-senha-grande-e-aleatoria

# E-mail(s) que podem acessar /master. Separe múltiplos por vírgula.
MASTER_EMAILS=
